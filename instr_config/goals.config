# goals.config - Đánh giá 6 mục tiêu bài lab Clickjacking
#DOC: Đăng nhập vào NovaPay qua Firefox và xác định trang /transfer
g_login = boolean : r_login

#DOC: Sử dụng curl -I kiểm tra các header an toàn của trang /transfer
g_curl_check = boolean : r_curl_check

#DOC: Tạo file test.html trong thư mục www chứng minh /transfer có thể bị nhúng iframe
g_test_iframe = boolean : r_test_iframe

#DOC: Hoàn thiện trang mồi index.html với iframe trong suốt (opacity: 0)
g_index_opacity = boolean : r_index_opacity

#DOC: Tấn công clickjacking thành công qua iframe (POST /transfer dest=iframe)
g_transfer = boolean : r_transfer

#DOC: Vá lỗ hổng bằng header X-Frame-Options và kiểm tra lại bằng curl
g_header_deny = boolean : r_header_deny
