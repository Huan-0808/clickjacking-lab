# results.config - Đánh giá kết quả 6 tasks bài lab Clickjacking
# Task 1: Nạn nhân đăng nhập NovaPay thành công
r_login = victim:novapay.log : CONTAINS : POST /login

# Task 2: Sinh viên dùng curl -I kiểm tra header của trang transfer
r_curl_check = attacker:.bash_history : CONTAINS : curl -I

# Task 3: Sinh viên tạo hoặc kiểm thử với test.html có nhúng iframe
r_test_iframe = attacker:www/test.html : CONTAINS : iframe

# Task 4: Sinh viên hoàn thiện trang mồi với thuộc tính opacity: 0
r_index_opacity = attacker:www/index.html : CONTAINS : opacity: 0

# Task 5: Cuộc tấn công thành công qua iframe (Sec-Fetch-Dest: iframe)
r_transfer = victim:novapay.log : CONTAINS : POST /transfer dest=iframe

# Task 6: Kiểm tra header sau khi vá lỗi bằng curl
r_header_deny = attacker:curl.stdout : CONTAINS : X-Frame-Options
