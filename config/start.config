# Filename : start.config
# Description: Lab Clickjacking NovaPay

GLOBAL_SETTINGS
    GRADE_CONTAINER attacker
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED clickjacking_master_seed
    COLLECT_DOCS YES

NETWORK CLICK_NET
    MASK 172.25.0.0/24
    GATEWAY 172.25.0.101

CONTAINER victim
    USER ubuntu
    TERMINALS 1
    CLICK_NET 172.25.0.2
    ADD-HOST attacker:172.25.0.3
    X11 YES

CONTAINER attacker
    USER ubuntu
    TERMINALS 1
    CLICK_NET 172.25.0.3
    ADD-HOST victim:172.25.0.2
    X11 YES
